<icecast>
    <location>Home</location>
    <admin>admin@localhost</admin>

    <limits>
        <clients>100</clients>
        <sources>2</sources>
        <!-- Icecast has no dedicated format handler for raw ADTS AAC, so it
             falls back to a generic byte-relay handler that (empirically)
             waits for something close to a full queue-size buffer before it
             starts serving a newly-connected listener. queue-size isn't just
             a startup knob either: it's how much audio Icecast holds
             in-flight for an ALREADY-connected listener, so it sets a floor
             on steady-state latency behind live, not just time-to-first-audio.
             At AAC_BITRATE's ~4000 bytes/sec, the previous 32768-byte queue
             meant ~8s of audio sitting buffered at all times (confirmed
             against a real ~10s TG-to-audio delay). 8192 bytes is ~2s of
             slack, enough to absorb normal jitter on a LAN/Tailscale
             listener without reintroducing multi-second lag. Shrink further
             (and shrink burst-size to match) if you want it tighter still,
             at the cost of less resilience to a slow/bursty listener. -->
        <queue-size>8192</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
        <burst-on-connect>1</burst-on-connect>
        <burst-size>4096</burst-size>
    </limits>

    <authentication>
        <!-- Password the audio-bridge container uses to connect as the AAC source. -->
        <source-password>${ICECAST_SOURCE_PASSWORD}</source-password>
        <relay-password>${ICECAST_SOURCE_PASSWORD}</relay-password>
        <admin-user>admin</admin-user>
        <admin-password>${ICECAST_ADMIN_PASSWORD}</admin-password>
    </authentication>

    <hostname>localhost</hostname>

    <listen-socket>
        <port>8000</port>
        <bind-address>0.0.0.0</bind-address>
    </listen-socket>

    <fileserve>1</fileserve>

    <paths>
        <basedir>/usr/share/icecast2</basedir>
        <logdir>/var/log/icecast2</logdir>
        <webroot>/usr/share/icecast2/web</webroot>
        <adminroot>/usr/share/icecast2/admin</adminroot>
        <alias source="/" destination="/status.xsl"/>
    </paths>

    <logging>
        <accesslog>access.log</accesslog>
        <errorlog>error.log</errorlog>
        <loglevel>3</loglevel>
        <logsize>10000</logsize>
    </logging>

    <security>
        <chroot>0</chroot>
        <changeowner>
            <user>icecast2</user>
            <group>icecast</group>
        </changeowner>
    </security>
</icecast>
