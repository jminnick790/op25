<icecast>
    <location>Home</location>
    <admin>admin@localhost</admin>

    <limits>
        <clients>100</clients>
        <sources>2</sources>
        <!-- Icecast has no dedicated format handler for raw ADTS AAC, so it
             falls back to a generic byte-relay handler that (empirically)
             waits for something close to a full queue-size buffer before it
             starts serving a newly-connected listener. At the low bitrate
             an 8kHz mono voice stream needs (see AAC_BITRATE), the default
             512KB queue-size means new listeners wait ~2 minutes before
             hearing anything. Keeping this small trades a bit of
             resilience to slow listeners for a live stream that actually
             starts promptly. -->
        <queue-size>32768</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
        <burst-on-connect>1</burst-on-connect>
        <burst-size>16384</burst-size>
    </limits>

    <authentication>
        <!-- Password the audio-bridge container uses to connect as the AAC source. -->
        <source-password>${ICECAST_SOURCE_PASSWORD}</source-password>
        <relay-password>${ICECAST_SOURCE_PASSWORD}</relay-password>
        <admin-user>admin</admin-user>
        <admin-password>${ICECAST_ADMIN_PASSWORD}</admin-password>
    </authentication>

    <hostname>localhost</hostname>

    <listen-socket>
        <port>8000</port>
        <bind-address>0.0.0.0</bind-address>
    </listen-socket>

    <fileserve>1</fileserve>

    <paths>
        <basedir>/usr/share/icecast2</basedir>
        <logdir>/var/log/icecast2</logdir>
        <webroot>/usr/share/icecast2/web</webroot>
        <adminroot>/usr/share/icecast2/admin</adminroot>
        <alias source="/" destination="/status.xsl"/>
    </paths>

    <logging>
        <accesslog>access.log</accesslog>
        <errorlog>error.log</errorlog>
        <loglevel>3</loglevel>
        <logsize>10000</logsize>
    </logging>

    <security>
        <chroot>0</chroot>
        <changeowner>
            <user>icecast2</user>
            <group>icecast</group>
        </changeowner>
    </security>
</icecast>
