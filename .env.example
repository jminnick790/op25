# Copy this file to .env and fill in real values before running
# `docker compose up`.

# --- Remote SDR (Pi Zero 2W running rtl_tcp) ---
SDR_HOST=192.168.1.50
SDR_PORT=1234
# Sample rate rx.py requests from rtl_tcp. 960000 is a safe default for a
# single P25 control channel over a Pi Zero 2W's WiFi link; raise it if you
# need to cover a wider control-channel hunt list and your LAN can take it.
SDR_SAMPLE_RATE=960000
# PPM frequency correction for the dongle, if needed
SDR_PPM=0
# Optional gain string passed to rx.py -N, e.g. "LNA:39". Leave blank for
# gr-osmosdr's default AGC.
SDR_GAIN=
# The bundled example config (docker/config/trunk.tsv) is the Lincolnton
# site of North Carolina VIPER, Lincoln County -- a P25 Phase II system.
# ENABLE_PHASE2 (-2) enables TDMA voice decode for when a call gets granted
# onto a Phase 2 voice channel. ENABLE_TDMA_CC (--tdma-cc) is a DIFFERENT
# thing -- it's only for systems whose CONTROL channel itself is TDMA, which
# is uncommon; most Phase 2 systems (VIPER included) keep the control channel
# plain FDMA/C4FM for legacy-radio compatibility. Setting --tdma-cc against
# an FDMA control channel forces the wrong symbol rate (6000 baud instead of
# 4800) and breaks control channel decode entirely -- confirmed against a
# real VIPER site. Only set this true if you've confirmed your specific
# system's control channel is actually TDMA.
ENABLE_TDMA_CC=false
ENABLE_PHASE2=true
LOG_VERBOSITY=1

# --- Icecast ---
ICECAST_SOURCE_PASSWORD=changeme-source-password
ICECAST_ADMIN_PASSWORD=changeme-admin-password
ICECAST_MOUNT=op25
# OP25's decoded voice audio is 8kHz mono (narrowband) - AAC-LC's per-frame
# bit budget at that sample rate caps out well below typical music
# bitrates, so keep this modest (ffmpeg silently clamps anything higher,
# with a log warning, but won't actually improve quality).
AAC_BITRATE=32k

# Host port Icecast listens on. Only this port needs to be reachable beyond
# the compose network -- and only via Tailscale, never a public port forward.
ICECAST_HOST_PORT=8000

# OP25 HTTP status/terminal port (LAN/Tailscale only, not required for audio)
OP25_HTTP_HOST_PORT=8080
