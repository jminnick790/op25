# Copy this file to .env and fill in real values before running
# `docker compose up`.
#
# Note: the SDR device (rtl_tcp host/port/gain/ppm/etc.) and which trunked
# system is active are no longer set via env vars -- op25 reads its whole
# config from the SQLite DB (docker/config/schema.sql) via config-api's
# admin UI. See docker/config/migrate_json_to_sqlite.py for first-time
# bootstrap, or transplant an existing op25.db from another deployment
# (config-api's "Export Config" button) via `docker cp` into the
# op25-config-db named volume.

LOG_VERBOSITY=1

# --- Icecast (optional -- only used by the audio-bridge sidecar; the New UI's
# built-in WebSocket audio player on OP25_WS_AUDIO_HOST_PORT doesn't need it) ---
ICECAST_SOURCE_PASSWORD=changeme-source-password
ICECAST_ADMIN_PASSWORD=changeme-admin-password
ICECAST_MOUNT=op25
# OP25's decoded voice audio is 8kHz mono (narrowband) - AAC-LC's per-frame
# bit budget at that sample rate caps out well below typical music
# bitrates, so keep this modest (ffmpeg silently clamps anything higher,
# with a log warning, but won't actually improve quality).
AAC_BITRATE=32k

# Host port Icecast listens on. Only this port needs to be reachable beyond
# the compose network -- and only via Tailscale, never a public port forward.
ICECAST_HOST_PORT=8000

# OP25 HTTP status/terminal UI port (New UI, live audio player)
OP25_HTTP_HOST_PORT=8080
# OP25's built-in raw-PCM WebSocket audio server (multi_rx.py only)
OP25_WS_AUDIO_HOST_PORT=8081

# config-api admin UI (systems/talkgroups/access-lists CRUD, drag-reorder,
# search, Set Active, config export)
CONFIG_API_HOST_PORT=8091
