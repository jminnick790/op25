# Copy this file to .env and fill in real values before running
# `docker compose up`.
#
# Note: the SDR device (rtl_tcp host/port/gain/ppm/etc.) and which trunked
# system is active are no longer set via env vars -- op25 reads its whole
# config from the SQLite DB (docker/config/schema.sql) via the admin UI.
# See docker/config/migrate_json_to_sqlite.py for first-time bootstrap, or
# transplant an existing op25.db from another deployment (the admin UI's
# "Export Config" button) via `docker cp` into the op25-config-db named
# volume.

LOG_VERBOSITY=1

# OP25 HTTP status/terminal UI port (New UI, live audio player, SSE)
OP25_HTTP_HOST_PORT=8080
# OP25's built-in raw-PCM WebSocket audio server (multi_rx.py only)
OP25_WS_AUDIO_HOST_PORT=8081

# Admin UI (systems/talkgroups/access-lists CRUD, drag-reorder, search, Set
# Active, config export) -- served by the same op25 container/image as
# everything else now (formerly a separate config-api container).
CONFIG_API_HOST_PORT=8091

# Password for supervisord's control interface inside the op25 container
# (port 9001, loopback-only -- never leaves the container, since the
# process that restarts op25 for Set Active/DB import lives in the same
# container now too). Defense-in-depth only; change it if you want, the
# default is fine otherwise.
SUPERVISOR_HTTP_PASSWORD=op25supervisor
